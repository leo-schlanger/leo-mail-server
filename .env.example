# Copy to .env on the server (scripts/install.sh does it and fills the secrets).
# NEVER commit the real .env.

# Stalwart break-glass admin (format user:password). Needed for the first
# setup and for recovery. Remove it (or comment it) once the permanent admin
# works, then `docker compose up -d stalwart`.
STALWART_RECOVERY_ADMIN=admin:CHANGE_ME

# Bulwark "remember me" + settings sync encryption key: openssl rand -base64 32
BULWARK_SESSION_SECRET=CHANGE_ME

# Name shown in the webmail tab / login page
BULWARK_APP_NAME=Leo Mail

# Existing Traefik on the host (file provider + Let's Encrypt resolver)
TRAEFIK_DYNAMIC_DIR=/path/to/traefik/dynamic-config
TRAEFIK_ACME_JSON=/var/lib/docker/volumes/<traefik-volume>/_data/acme.json
TRAEFIK_CERT_RESOLVER=letsencrypt
